# Copie para .env. O .env não é versionado.

# Mesmas credenciais do docker-compose.yml (banco acessível só em 127.0.0.1).
DATABASE_URL=postgres://vitorias:vitorias@127.0.0.1:5432/vitorias

# E-mail de login do administrador, usado pelo seed. Nenhum e-mail é enviado.
ADMIN_EMAIL=admin@example.com

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
